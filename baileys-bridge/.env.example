# انسخ هذا الملف إلى .env ثم عدّل القيم  /  Copy this file to .env and edit values

# عنوان Webhook الخاص بـ n8n (بعد تفعيل الـ Workflow)
# Production URL = http://<n8n-host>:5678/webhook/masjid-bot
# Test URL       = http://<n8n-host>:5678/webhook-test/masjid-bot
N8N_WEBHOOK_URL=http://localhost:5678/webhook/masjid-bot

# المنفذ الذي يستمع عليه هذا الجسر (يستدعيه n8n لإرسال الردود)
PORT=3000

# سرّ اختياري لحماية مسار /send (اتركه فارغًا لتعطيله)
# إن فعّلته، أضف في n8n هيدر: x-api-token = نفس القيمة
API_TOKEN=

# مجلد حفظ جلسة واتساب (لا تحذفه إلا عند الرغبة بإعادة الربط)
AUTH_DIR=auth_info

# مستوى السجلّات: silent | info | debug
LOG_LEVEL=silent
