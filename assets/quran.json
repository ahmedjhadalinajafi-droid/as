  },
  {
    "id": 97,
    "name": "القدر",
    "transliteration": "Al-Qadr",
    "type": "meccan",
    "total_verses": 5,
    "verses": [
      {
        "id": 1,
        "text": "إِنَّا أَنزَلْنَاهُ فِي لَيْلَةِ الْقَدْرِ"
      },
      {
        "id": 2,
        "text": "وَمَا أَدْرَاكَ مَا لَيْلَةُ الْقَدْرِ"
      },
      {
        "id": 3,
        "text": "لَيْلَةُ الْقَدْرِ خَيْرٌ مِّنْ أَلْفِ شَهْرٍ"
      },
      {
        "id": 4,
        "text": "تَنَزَّلُ الْمَلَائِكَةُ وَالرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍ"
      },
      {
        "id": 5,
        "text": "سَلَامٌ هِيَ حَتَّىٰ مَطْلَعِ الْفَجْرِ"
      }
    ]
  },
  {
    "id": 98,
    "name": "البينة",
    "transliteration": "Al-Bayyinah",
    "type": "medinan",
    "total_verses": 8,
    "verses": []
  },
  {
    "id": 99,
    "name": "الزلزلة",
    "transliteration": "Az-Zalzalah",
    "type": "medinan",
    "total_verses": 8,
    "verses": [
      {
        "id": 1,
        "text": "إِذَا زُلْزِلَتِ الْأَرْضُ زِلْزَالَهَا"
      },
      {
        "id": 2,
        "text": "وَأَخْرَجَتِ الْأَرْضُ أَثْقَالَهَا"
      },
      {
        "id": 3,
        "text": "وَقَالَ الْإِنسَانُ مَا لَهَا"
      },
      {
        "id": 4,
        "text": "يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا"
      },
      {
        "id": 5,
        "text": "بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا"
      },
      {
        "id": 6,
        "text": "يَوْمَئِذٍ يَصْدُرُ النَّاسُ أَشْتَاتًا لِّيُرَوْا أَعْمَالَهُمْ"
      },
      {
        "id": 7,
        "text": "فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ"
      },
      {
        "id": 8,
        "text": "وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُ"
      }
    ]
  },
  {
    "id": 100,
    "name": "العاديات",
    "transliteration": "Al-Adiyat",
    "type": "meccan",
    "total_verses": 11,
    "verses": []
  },
  {
    "id": 101,
    "name": "القارعة",
    "transliteration": "Al-Qariah",
    "type": "meccan",
    "total_verses": 11,
    "verses": []
  },
  {
    "id": 102,
    "name": "التكاثر",
    "transliteration": "At-Takathur",
    "type": "meccan",
    "total_verses": 8,
    "verses": []
  },
  {
    "id": 103,
    "name": "العصر",
    "transliteration": "Al-Asr",
    "type": "meccan",
    "total_verses": 3,
    "verses": [
      {
        "id": 1,
        "text": "وَالْعَصْرِ"
      },
      {
        "id": 2,
        "text": "إِنَّ الْإِنسَانَ لَفِي خُسْرٍ"
      },
      {
        "id": 3,
        "text": "إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ"
      }
    ]
  },
  {
    "id": 104,
    "name": "الهمزة",
    "transliteration": "Al-Humazah",
    "type": "meccan",
    "total_verses": 9,
    "verses": []
  },
  {
    "id": 105,
    "name": "الفيل",
    "transliteration": "Al-Fil",
    "type": "meccan",
    "total_verses": 5,
    "verses": [
      {
        "id": 1,
        "text": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَابِ الْفِيلِ"
      },
      {
        "id": 2,
        "text": "أَلَمْ يَجْعَلْ كَيْدَهُمْ فِي تَضْلِيلٍ"
      },
      {
        "id": 3,
        "text": "وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ"
      },
      {
        "id": 4,
        "text": "تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ"
      },
      {
        "id": 5,
        "text": "فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍ"
      }
    ]
  },
  {
    "id": 106,
    "name": "قريش",
    "transliteration": "Quraysh",
    "type": "meccan",
    "total_verses": 4,
    "verses": [
      {
        "id": 1,
        "text": "لِإِيلَافِ قُرَيْشٍ"
      },
      {
        "id": 2,
        "text": "إِيلَافِهِمْ رِحْلَةَ الشِّتَاءِ وَالصَّيْفِ"
      },
      {
        "id": 3,
        "text": "فَلْيَعْبُدُوا رَبَّ هَٰذَا الْبَيْتِ"
      },
      {
        "id": 4,
        "text": "الَّذِي أَطْعَمَهُم مِّن جُوعٍ وَآمَنَهُم مِّنْ خَوْفٍ"
      }
    ]
  },
  {
    "id": 107,
    "name": "الماعون",
    "transliteration": "Al-Maun",
    "type": "meccan",
    "total_verses": 7,
    "verses": [
      {
        "id": 1,
        "text": "أَرَأَيْتَ الَّذِي يُكَذِّبُ بِالدِّينِ"
      },
      {
        "id": 2,
        "text": "فَذَٰلِكَ الَّذِي يَدُعُّ الْيَتِيمَ"
      },
      {
        "id": 3,
        "text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ الْمِسْكِينِ"
      },
      {
        "id": 4,
        "text": "فَوَيْلٌ لِّلْمُصَلِّينَ"
      },
      {
        "id": 5,
        "text": "الَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ"
      },
      {
        "id": 6,
        "text": "الَّذِينَ هُمْ يُرَاءُونَ"
      },
      {
        "id": 7,
        "text": "وَيَمْنَعُونَ الْمَاعُونَ"
      }
    ]
  },
  {
    "id": 108,
    "name": "الكوثر",
    "transliteration": "Al-Kawthar",
    "type": "meccan",
    "total_verses": 3,
    "verses": [
      {
        "id": 1,
        "text": "إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ"
      },
      {
        "id": 2,
        "text": "فَصَلِّ لِرَبِّكَ وَانْحَرْ"
      },
      {
        "id": 3,
        "text": "إِنَّ شَانِئَكَ هُوَ الْأَبْتَرُ"
      }
    ]
  },
  {
    "id": 109,
    "name": "الكافرون",
    "transliteration": "Al-Kafirun",
    "type": "meccan",
    "total_verses": 6,
    "verses": [
      {
        "id": 1,
        "text": "قُلْ يَا أَيُّهَا الْكَافِرُونَ"
      },
      {
        "id": 2,
        "text": "لَا أَعْبُدُ مَا تَعْبُدُونَ"
      },
      {
        "id": 3,
        "text": "وَلَا أَنتُمْ عَابِدُونَ مَا أَعْبُدُ"
      },
      {
        "id": 4,
        "text": "وَلَا أَنَا عَابِدٌ مَّا عَبَدتُّمْ"
      },
      {
        "id": 5,
        "text": "وَلَا أَنتُمْ عَابِدُونَ مَا أَعْبُدُ"
      },
      {
        "id": 6,
        "text": "لَكُمْ دِينُكُمْ وَلِيَ دِينِ"
      }
    ]
  },
  {
    "id": 110,
    "name": "النصر",
    "transliteration": "An-Nasr",
    "type": "medinan",
    "total_verses": 3,
    "verses": [
      {
        "id": 1,
        "text": "إِذَا جَاءَ نَصْرُ اللَّهِ وَالْفَتْحُ"
      },
      {
        "id": 2,
        "text": "وَرَأَيْتَ النَّاسَ يَدْخُلُونَ فِي دِينِ اللَّهِ أَفْوَاجًا"
      },
      {
        "id": 3,
        "text": "فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ ۚ إِنَّهُ كَانَ تَوَّابًا"
      }
    ]
  },
  {
    "id": 111,
    "name": "المسد",
    "transliteration": "Al-Masad",
    "type": "meccan",
    "total_verses": 5,
    "verses": [
      {
        "id": 1,
        "text": "تَبَّتْ يَدَا أَبِي لَهَبٍ وَتَبَّ"
      },
      {
        "id": 2,
        "text": "مَا أَغْنَىٰ عَنْهُ مَالُهُ وَمَا كَسَبَ"
      },
      {
        "id": 3,
        "text": "سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ"
      },
      {
        "id": 4,
        "text": "وَامْرَأَتُهُ حَمَّالَةَ الْحَطَبِ"
      },
      {
        "id": 5,
        "text": "فِي جِيدِهَا حَبْلٌ مِّن مَّسَدٍ"
      }
    ]
  },
  {
    "id": 112,
    "name": "الإخلاص",
    "transliteration": "Al-Ikhlas",
    "type": "meccan",
    "total_verses": 4,
    "verses": [
      {
        "id": 1,
        "text": "قُلْ هُوَ اللَّهُ أَحَدٌ"
      },
      {
        "id": 2,
        "text": "اللَّهُ الصَّمَدُ"
      },
      {
        "id": 3,
        "text": "لَمْ يَلِدْ وَلَمْ يُولَدْ"
      },
      {
        "id": 4,
        "text": "وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ"
      }
    ]
  },
  {
    "id": 113,
    "name": "الفلق",
    "transliteration": "Al-Falaq",
    "type": "meccan",
    "total_verses": 5,
    "verses": [
      {
        "id": 1,
        "text": "قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ"
      },
      {
        "id": 2,
        "text": "مِن شَرِّ مَا خَلَقَ"
      },
      {
        "id": 3,
        "text": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ"
      },
      {
        "id": 4,
        "text": "وَمِن شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ"
      },
      {
        "id": 5,
        "text": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ"
      }
    ]
  },
  {
    "id": 114,
    "name": "الناس",
    "transliteration": "An-Nas",
    "type": "meccan",
    "total_verses": 6,
    "verses": [
      {
        "id": 1,
        "text": "قُلْ أَعُوذُ بِرَبِّ النَّاسِ"
      },
      {
        "id": 2,
        "text": "مَلِكِ النَّاسِ"
      },
      {
        "id": 3,
        "text": "إِلَٰهِ النَّاسِ"
      },
      {
        "id": 4,
        "text": "مِن شَرِّ الْوَسْوَاسِ الْخَنَّاسِ"
      },
      {
        "id": 5,
        "text": "الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ"
      },
      {
        "id": 6,
        "text": "مِنَ الْجِنَّةِ وَالنَّاسِ"
      }
    ]
  }
]